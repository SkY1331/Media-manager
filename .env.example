APP_NAME=Les envies pour Plex
DATABASE_URL=sqlite:////data/media.db

# Chemin de la bibliothèque films SUR L'HÔTE (monté en lecture seule dans le conteneur).
# Exemples : /mnt/films  |  D:/Films  |  /volume1/video/Movies
LIBRARY_HOST_PATH=/chemin/vers/votre/bibliotheque
LIBRARY_PATH=/media/movies

WISHLIST_INTERVAL_MINUTES=360
DISCOVERY_INTERVAL_MINUTES=360
DISCOVERY_MIN_RATING=7
DISCOVERY_MIN_VOTES=40
DISCOVERY_RELEASED_DAYS=60
DISCOVERY_UPCOMING_DAYS=90
DISCOVERY_MAX_RESULTS=20
DISCOVERY_AUTO_ADD_NOUVEAUTES=false
DISCOVERY_AUTO_ADD_ATTENDUS=false
DISCOVERY_AUTO_ADD_CLASSIQUES=false
DISCOVERY_AUTO_DOWNLOAD=false
DISCOVERY_CLASSIC_MIN_RATING=8
DISCOVERY_CLASSIC_MIN_VOTES=1500
DISCOVERY_CLASSIC_MIN_AGE_YEARS=10

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Clé Torznab (indexer C411). Laisser vide tant que vous ne l'avez pas.
C411_API_KEY=
C411_ENDPOINT=https://c411.org/api/torznab
C411_CATEGORIES=2000,2010,2030,2050,2060,2070,2080,2090,5000,5060,5070,5080
C411_REQUEST_DELAY_SECONDS=4.2

QUALITY_REQUIRED_LANGUAGE=MULTI
QUALITY_PREFERRED_RESOLUTION=1080p
QUALITY_PREFERRED_CODECS=H265,x265,HEVC
QUALITY_MAX_SIZE_GB=5
QUALITY_ALLOWED_SOURCES=WEB-DL,WEBRip,BluRay,WEB
QUALITY_MIN_SEEDERS=2

# Transmission joignable depuis le conteneur backend.
# host.docker.internal = daemon Docker sur la machine hôte (Linux : extra_hosts déjà dans compose).
TRANSMISSION_URL=http://host.docker.internal:9091/transmission/rpc
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=
TRANSMISSION_DOWNLOAD_DIR=/chemin/vers/votre/dossier/telechargements

# Accès web : laisser true avant toute ouverture réseau.
AUTH_ENABLE=true
AUTH_USERNAME=admin
AUTH_PASSWORD=changez-moi
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-session-secret
AUTH_SESSION_DAYS=7
# true uniquement derrière HTTPS (reverse proxy, Cloudflare Tunnel, etc.)
AUTH_COOKIE_SECURE=false
# URL d'accès au frontend (ajoutez l'IP LAN ou le nom DNS si besoin)
AUTH_CORS_ORIGINS=http://localhost:5173
